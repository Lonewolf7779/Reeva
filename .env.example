# Reeva Environment Configuration Template
# Copy this file to .env and configure for your environment.

# Server Port
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Trust Proxy Configuration
# Do not set to true unless running behind a trusted reverse proxy (e.g., Cloudflare, GCP Load Balancer)
# Set to 'loopback', '1', or specific IP addresses if behind a reverse proxy.
# Default: false
TRUST_PROXY=false

# Rate Limiting Configuration
# General static & page requests (window: 15 minutes)
RATE_LIMIT_GENERAL_MAX=100
# Extraction requests (/api/download/:platform, window: 1 minute)
RATE_LIMIT_EXTRACTION_MAX=15
# Media streaming requests (/api/media/:id, window: 5 minutes)
RATE_LIMIT_MEDIA_MAX=30

# Concurrency Controls (Simultaneous in-flight requests)
# Maximum global concurrent extractions & media streams
MAX_GLOBAL_CONCURRENCY=50
# Maximum concurrent extractions & media streams per IP address
MAX_IP_CONCURRENCY=3

# Resource Limits
# Maximum media file size in bytes (default: 250 MB = 262144000)
MAX_MEDIA_SIZE_BYTES=262144000

# In-Memory Cache Settings (Process-Local)
CACHE_MAX_ENTRIES=500
CACHE_TTL_MS=600000

# ==============================================================================
# YouTube Extraction Runtime Configuration
# ==============================================================================
# Standalone, pinned yt-dlp binary path (Required in production)
# Example Linux: /usr/local/bin/yt-dlp
# Example Windows: C:\Program Files\yt-dlp\yt-dlp.exe
# Pinned version recommended: yt-dlp 2026.08.19 or later
# Standalone binary downloads: https://github.com/yt-dlp/yt-dlp/releases
YT_DLP_PATH=

# Explicit FFmpeg executable path (Required for VIDEO_AND_AUDIO merging)
# Example Linux: /usr/bin/ffmpeg
# Example Windows: C:\Program Files\ffmpeg\bin\ffmpeg.exe
# Required version: FFmpeg 6.x or 7.x
FFMPEG_PATH=

# Temporary media directory for merged artifacts
# Default: System temp directory / reeva_media
# REEVA_TEMP_DIR=/tmp/reeva_media

# Subprocess buffer limits in bytes
# MAX_SUBPROCESS_STDOUT_BYTES=4194304
# MAX_SUBPROCESS_STDERR_BYTES=1048576

# Optional external egress proxy URL (if using an upstream egress security gateway)
# Default: Reeva starts and manages an internal loopback egress proxy (127.0.0.1) automatically
# REEVA_EGRESS_PROXY_URL=


